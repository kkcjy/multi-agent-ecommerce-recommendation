# LLM Configuration
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.meai.cloud/v1
ECOM_LLM_MODEL=glm-5.1
ECOM_LLM_ENABLE_THINKING=false

# Redis
ECOM_REDIS_URL=redis://localhost:6379/0

# Milvus
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530

# Database
ECOM_DATABASE_URL=sqlite:///./ecommerce.db

# A/B Testing
ECOM_AB_TEST_ENABLED=true

# Security - Admin API Key (required for /api/v1/experiments and /api/v1/metrics)
ECOM_ADMIN_API_KEY=replace_with_strong_api_key

# Security - CORS whitelist (comma separated)
ECOM_CORS_ALLOW_ORIGINS=http://localhost:8866,http://127.0.0.1:8866
ECOM_CORS_ALLOW_METHODS=GET,POST,OPTIONS
ECOM_CORS_ALLOW_HEADERS=Content-Type,Authorization,X-API-Key

# Security - Rate limit
ECOM_RATE_LIMIT_ENABLED=true
ECOM_RATE_LIMIT_WINDOW_SECONDS=60
ECOM_RATE_LIMIT_RECOMMEND_PER_WINDOW=30
ECOM_RATE_LIMIT_GRAPH_PER_WINDOW=20
